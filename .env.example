# Copy to .env and adjust. Every backend setting is DIVERT_-prefixed (see backend/src/divert/config.py).
# Never commit .env.

# --- docker compose: postgres container + published ports
POSTGRES_USER=divert
POSTGRES_PASSWORD=divert
POSTGRES_DB=divert
DIVERT_PG_PORT=5432
DIVERT_REDIS_PORT=6379
DIVERT_API_PORT=8000
DIVERT_WEB_PORT=8080
# Frontend basemap (build args, baked into the bundle). Empty = OpenStreetMap standard tiles,
# acceptable for development/demos under the OSMF tile usage policy; production should use a
# keyed provider or self-hosted tiles, e.g. https://tiles.example.org/{z}/{x}/{y}.png
DIVERT_WEB_TILE_URL=
DIVERT_WEB_TILE_URL_DARK=
DIVERT_WEB_TILE_ATTRIBUTION=
GRAFANA_ADMIN_PASSWORD=change-me

# --- backend (outside compose, e.g. `uv run divert migrate` from backend/)
DIVERT_ENV=dev
DIVERT_LOG_LEVEL=INFO
DIVERT_LOG_JSON=true
DIVERT_DATABASE_URL=postgresql+asyncpg://divert:divert@localhost:5432/divert
DIVERT_REDIS_URL=redis://localhost:6379/0
# API request path: per-call Redis deadline (no retries) and how long to skip Redis after
# a failure (circuit breaker) - a Redis outage never stalls a dispatch.
DIVERT_REDIS_REQUEST_TIMEOUT_S=0.5
DIVERT_REDIS_CIRCUIT_COOLDOWN_S=5
DIVERT_CITIES=delhi,kolkata,bengaluru
DIVERT_UNITS_PER_STATION=2

# Routing: public OSRM demo (fair use only). Production: self-host (compose profile 'osrm').
DIVERT_OSRM_URL=https://router.project-osrm.org
DIVERT_OSRM_TIMEOUT_S=8
DIVERT_OSRM_RETRIES=2
DIVERT_OSRM_CACHE_TTL_S=3600

# Corridor / preemption
DIVERT_CORRIDOR_M=30
DIVERT_PREEMPT_LEAD_S=45
DIVERT_PREEMPT_DISTANCE_M=600
DIVERT_PREEMPT_RELEASE_PAST_M=20

DIVERT_CONFLICT_TIE_S=5

# Simulation
DIVERT_SIM_TICK_S=0.5
DIVERT_SIM_TIME_SCALE=1
DIVERT_SCENE_TIME_S=120
DIVERT_POSITION_SAMPLE_S=5
DIVERT_POSITION_RETENTION_DAYS=30

# Worker / persister / outbox
DIVERT_LEADER_LOCK_TTL_MS=5000
DIVERT_HEARTBEAT_MAX_AGE_S=10
DIVERT_PERSISTER_BATCH=200
DIVERT_PERSISTER_MAX_RETRIES=5
DIVERT_OUTBOX_RELAY_INTERVAL_S=2
DIVERT_OUTBOX_RETENTION_DAYS=7
DIVERT_METRICS_PORT=9100

# API: optional key for mutating endpoints (X-API-Key); explicit CORS origins only
DIVERT_API_KEY=
DIVERT_CORS_ORIGINS=http://localhost:8080,http://localhost:5173
DIVERT_RATE_LIMIT_PER_MIN=60
# only behind a proxy you control: rate-limit on X-Forwarded-For
DIVERT_TRUST_PROXY_HEADERS=false

# Tests (backend/tests/integration)
DIVERT_TEST_DATABASE_URL=postgresql+asyncpg://divert:divert@localhost:5432/divert_test
DIVERT_TEST_REDIS_URL=redis://localhost:6379/15
