# Serves the built SPA and proxies the API (REST + WebSocket) to the backend, so the
# browser only ever talks to this origin (no CORS, no hard-coded API host in the bundle).
#
# This is a TEMPLATE: the nginx image's entrypoint renders it to
# /etc/nginx/conf.d/default.conf at container start (envsubst, limited to the variables
# named in NGINX_ENVSUBST_FILTER - see the Dockerfile):
#   DIVERT_API_UPSTREAM    host:port of the API. compose: api:8000 (image default);
#                          k8s: divert-api.<namespace>.svc.cluster.local:80
#   NGINX_LOCAL_RESOLVERS  the container's DNS servers (from /etc/resolv.conf; Docker's
#                          127.0.0.11 or kube-dns), exported by the image when
#                          NGINX_ENTRYPOINT_LOCAL_RESOLVERS=1
#
# The upstream is resolved at request time (variable proxy_pass + resolver, re-resolved
# every 10 s), not once at start-up: nginx starts even if the API does not exist yet,
# follows the API to a new address when its container/pod is recreated, and spreads load
# over every address the name resolves to (scaled compose replicas). NB: the resolver
# does not apply search domains, so in k8s DIVERT_API_UPSTREAM must be a full name.

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;
    server_tokens off;

    resolver ${NGINX_LOCAL_RESOLVERS} valid=10s ipv6=off;
    resolver_timeout 3s;
    set $api_upstream http://${DIVERT_API_UPSTREAM};

    gzip on;
    gzip_comp_level 5;
    gzip_min_length 1024;
    gzip_types text/css application/javascript application/json image/svg+xml;

    # Security headers. NB: nginx drops inherited add_header directives in any location that
    # declares its own, so locations below include the same snippet via variables.
    set $csp "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; connect-src 'self' ws: wss:; font-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'";
    add_header Content-Security-Policy $csp always;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header Permissions-Policy "geolocation=(), camera=(), microphone=()" always;

    # nginx itself (k8s liveness: must not depend on the API)
    location = /nginx-health { access_log off; return 200 "ok\n"; }

    location /api/ {
        # variable without a URI part: the original request URI is passed unchanged
        proxy_pass $api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Request-ID $request_id;
        # WebSocket: /api/v1/cities/{city}/stream
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_buffering off;
    }

    # API liveness/readiness through the proxy (compose healthcheck probes /healthz here,
    # so a broken nginx -> api path shows up as an unhealthy frontend)
    location ~ ^/(healthz|readyz)$ {
        proxy_pass $api_upstream;
        proxy_set_header X-Request-ID $request_id;
    }

    # Content-hashed build output: cache forever.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        add_header Content-Security-Policy $csp always;
        add_header X-Content-Type-Options nosniff always;
        try_files $uri =404;
    }

    # The SPA shell must always be revalidated so a deploy is picked up immediately.
    location = /index.html {
        add_header Cache-Control "no-cache" always;
        add_header Content-Security-Policy $csp always;
        add_header X-Content-Type-Options nosniff always;
        add_header X-Frame-Options DENY always;
        add_header Referrer-Policy strict-origin-when-cross-origin always;
    }

    location / { try_files $uri $uri/ /index.html; }
}
